{
  "name": "moongchijang-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "turbo run dev --filter=@moongchijang/web",
    "dev:mock": "turbo run dev:mock --filter=@moongchijang/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
