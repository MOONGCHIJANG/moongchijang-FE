# API 호출 모드
# - mock   : 로컬 개발 (Express 목서버 사용, pnpm dev:mock)
# - static : 데모 배포 (정적 JSON/준비중 응답, 부분적으로 실서버)
# - real   : 프로덕션 (전부 실서버)
NEXT_PUBLIC_API_MODE=mock

# API base URL
# - mock 모드   : Express 목서버 주소 (http://localhost:9090)
# - static 모드 : Next.js 앱 자신의 주소 (로컬: http://localhost:3000, 배포: https://your-domain.com)
# - real 모드   : 실서버 도메인
NEXT_PUBLIC_API_BASE_URL=http://localhost:9090

# 사이트 URL (OG 태그, 공유 링크 등)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kakao JavaScript SDK (공유하기 등 JS SDK 초기화용)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Kakao OAuth 로그인 (kauth.kakao.com authorize URL용)
# CLIENT_ID: 카카오 개발자 콘솔의 "REST API 키" (JS 키와 다름)
# REDIRECT_URI: 카카오 개발자 콘솔에 등록된 Redirect URI와 일치해야 함
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/login/kakao/callback

# PortOne 결제
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# Naver Maps API
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
